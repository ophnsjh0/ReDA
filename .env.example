# ReDA 설정 예시. 이 파일을 .env로 복사해서 값을 채운다. (.env는 git에 올리지 않는다)
#   cp .env.example .env
#
# 사용자(Hermes 프로필) 한 명당 .env 하나, REDA_DATA_DIR 하나를 둔다.

# ---- 데이터 폴더 (Gmail 토큰, 상태 DB, 문서 색인이 생긴다. 사용자 한 명의 데이터 경계)
REDA_DATA_DIR=~/.reda

# ---- Gmail OAuth
# Google Cloud Console에서 받은 OAuth 클라이언트 파일. 비워 두면 REDA_DATA_DIR/credentials.json
REDA_GMAIL_CREDENTIALS_FILE=
# 동의 후 저장되는 토큰. 비워 두면 REDA_DATA_DIR/token.json
REDA_GMAIL_TOKEN_FILE=

# ---- 사용자 정보
# 본인 메일 주소(쉼표로 구분). 수신/참조 판정에 쓴다.
# 내가 속한 그룹 주소(메일링 리스트)도 함께 적는다. 그룹으로만 받은 메일도 "나에게 온 메일"로 본다.
REDA_MY_ADDRESSES=
# 고객사 도메인=고객사 이름 (쉼표로 구분). 예: a.com=고객사A,b.co.kr=고객사B
REDA_CUSTOMER_DOMAINS=
# 제목에 들어 있으면 규칙 필터에서 '참고'로 거르는 키워드 (쉼표로 구분)
REDA_EXCLUDE_SUBJECTS=

# ---- 기술 문서 검색 (8단계)
REDA_REFERENCE_DOCS_DIR=
REDA_REFERENCE_DB=
REDA_EMBEDDING_MODEL=text-embedding-3-small

# ---- 분류기 (Jev 사양을 받기 전 임시 LLM 구현)
REDA_CLASSIFIER_MODEL=claude-opus-5-5
# low / medium / high
REDA_CLASSIFIER_EFFORT=low

# ---- LLM / 임베딩 API 키
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
