# ReDA 설정 예시. 이 파일을 .env로 복사해서 값을 채운다. (.env는 git에 올리지 않는다)
#   cp .env.example .env
#
# 사용자(Hermes 프로필) 한 명당 .env 하나, REDA_DATA_DIR 하나를 둔다.

# ---- 데이터 폴더 (Gmail 토큰, 상태 DB, 문서 색인이 생긴다. 사용자 한 명의 데이터 경계)
REDA_DATA_DIR=~/.reda

# ---- Gmail OAuth
# Google Cloud Console에서 받은 OAuth 클라이언트 파일. 비워 두면 REDA_DATA_DIR/credentials.json
REDA_GMAIL_CREDENTIALS_FILE=
# 동의 후 저장되는 토큰. 비워 두면 REDA_DATA_DIR/token.json
REDA_GMAIL_TOKEN_FILE=

# ---- 사용자 정보 (개발용 덮어쓰기)
# 비워 두면 상태 DB, 그다음 Gmail에서 알아낸다 (메일 주소: 연결한 계정, 이름: 보내는 이름·보낸 메일).
# 여기 적은 값은 상태 DB에도 남는다. 배포 때는 사용자별 .env에 이 항목들을 두지 않는다 (결정 6-5).
# 지금 쓰는 값과 출처 확인: uv run reda profile
# 본인 개인 메일 주소(쉼표로 구분, user@domain 형식). 수신/참조 판정에 쓴다.
REDA_MY_ADDRESSES=
# 내가 속한 그룹(팀 메일) 주소. 그룹 주소로만 받은 요청은 인사말이 나를 부르거나 내가 답한 스레드일 때만
# 답장필요가 되고, 단서가 없으면 확인필요가 된다 (결정 2-5). Google Groups 메일은 List-Id 헤더와 바뀐
# From으로 그룹 주소를 알아내므로, 그룹의 별칭 주소(List-Id와 이름이 다른 주소)만 적으면 된다.
REDA_MY_GROUPS=
# 이름 프로필 (개발용. 배포 때는 메일함에서 자동으로 채우고 메신저로 확인받는다, 결정 6-3)
# 비우면 표시 이름은 Gmail 보내는 이름이나 최근 보낸 메일의 From에서 가져온다. `uv run reda profile`로 확인
REDA_MY_NAME=
# 직함 (쉼표로 구분). "성 + 직함"(예: 홍 부장님) 호칭을 알아보고, 직함이 다른 같은 이름을 구분한다
REDA_MY_TITLES=
# 그 밖에 불리는 이름 (영문 이름 등, 쉼표로 구분)
REDA_MY_ALIASES=
# 내가 직접 답하는 그룹 (쉼표로 구분). 이 그룹으로 온 요청은 담당 단서가 없어도 확인필요가 된다.
# 비우면 그룹으로 온 요청 중 담당 단서(인사말이 나, 내가 답한 스레드)가 없는 것은 참고가 된다
REDA_MY_OWNED_GROUPS=
# 고객사 도메인=고객사 이름 (쉼표로 구분). 예: a.com=고객사A,b.co.kr=고객사B
REDA_CUSTOMER_DOMAINS=
# 제목에 들어 있으면 규칙 필터에서 '참고'로 거르는 키워드 (쉼표로 구분)
REDA_EXCLUDE_SUBJECTS=

# ---- 기술 문서 검색 (8단계)
REDA_REFERENCE_DOCS_DIR=
REDA_REFERENCE_DB=
REDA_EMBEDDING_MODEL=text-embedding-3-small

# ---- 분류기 (설정만 바꾸면 제공자·모델이 바뀐다. 확인: uv run reda classifier --try)
# anthropic (Claude API, 기본) / jev (TypeSafe Jev)
REDA_CLASSIFIER=anthropic
# 비우면 제공자 기본값: anthropic → claude-opus-5-5, jev → jev-1.14.0 (버전 고정, 결정 2-9)
# 제공자를 바꿀 때는 이 값도 그 제공자의 모델 이름으로 바꾸거나 비운다
REDA_CLASSIFIER_MODEL=
# anthropic만: low / medium / high. effort를 지원하지 않는 모델이면 비운다
REDA_CLASSIFIER_EFFORT=low
# jev만: 판단을 "예"로 볼 기준 (아니오 기준은 1 - 이 값, 그 사이는 확인필요). 문서 권장 시작점 0.7
REDA_JEV_MIN_PROBABILITY=0.7

# ---- 자동 초안 (3단계, 결정 3-2). 켜면 reda poll 끝에 reda draft-pending이 이어서 돈다 (개발용 Mac)
REDA_AUTO_DRAFT=false
# 초안을 쓸 Hermes 프로필, 한 번에 맡길 메일 수, 메일당 기다리는 초
REDA_DRAFT_PROFILE=reda-dev
REDA_DRAFT_MAX_PER_RUN=2
REDA_DRAFT_TIMEOUT=300
# hermes 명령 경로. 비우면 PATH와 ~/.local/bin에서 찾는다 (LaunchAgent는 PATH가 짧다)
REDA_HERMES_BIN=

# ---- 출근 전 요약 (4단계, 결정 4-1). 이 시각(HH:MM, 이 컴퓨터 시각)이 지나면 그날 처음 도는 reda poll이 보낸다
# 비우면 자동으로 보내지 않는다 (uv run reda summary --send로 직접)
REDA_SUMMARY_AT=
# 메신저 봇이 연결된 Hermes 프로필과 보낼 곳 (hermes send --to 형식, 기본 대화방은 봇에게 /sethome)
REDA_SUMMARY_PROFILE=reda-dev
REDA_SUMMARY_TO=telegram
# 급한 메일 알림: 새로 분류한 답장필요·확인필요 중 긴급도 높음(제목 [긴급] 포함)을 15분 실행 때 바로 알린다
# 처음 켠 실행에서는 기준점만 잡고 보내지 않는다 (예전 메일이 한꺼번에 오지 않게)
REDA_URGENT_ALERT=false
# 일정 표시가 붙은 메일도 바로 알린다 (캘린더 등록 버튼은 9단계). 비우면 REDA_URGENT_ALERT를 따른다
REDA_SCHEDULE_ALERT=

# ---- LLM / 임베딩 API 키 (제공자마다 따로 둔다. 작업마다 제공자를 고르기 때문이다, 결정 0-7)
# Claude API (Anthropic SDK가 읽는 이름)
ANTHROPIC_API_KEY=
# TypeSafe Jev (분류)
TYPESAFE_API_KEY=
# OpenAI (임베딩)
OPENAI_API_KEY=
