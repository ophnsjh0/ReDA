# 시연용 인스턴스(reda-demo)의 ReDA 설정 예시. 운영과 다른 Gmail 계정을 쓴다.
#   cp deploy/demo.env.example .env.demo      (.env.*는 git에 올라가지 않는다)
# 빠진 항목의 뜻은 .env.example에 있다. 실제 고객 메일이 없는 시연 메일함에만 쓴다.

# 운영(~/.reda)과 반드시 다른 폴더. mac-handoff.sh가 같으면 멈춘다
REDA_DATA_DIR=~/.reda-demo
# 시연 계정용으로 새 Google Cloud 프로젝트에서 받은 OAuth 클라이언트 파일 (외부·테스트, 시연 계정을 테스트 사용자로)
# 운영 프로젝트의 사용자 유형을 바꾸지 않는다: 운영 토큰도 7일마다 만료될 수 있다
REDA_GMAIL_CREDENTIALS_FILE=~/.reda-demo/credentials.json

# 시연 계정 주소와 지어낸 엔지니어 이름 (실제 이름·회사를 쓰지 않는다)
REDA_MY_ADDRESSES=<시연 Gmail 주소>
REDA_MY_NAME=<지어낸 이름>
REDA_MY_TITLES=책임
# 리뷰어가 개인 Gmail로 보내면 보낸 곳이 gmail.com이다. 고객사로 보면 긴급도가 운영처럼 매겨진다.
# 한계: 시연 계정도 gmail.com이라 보낸 사람을 사내로 보고 지난 메일 검색은 건너뛴다 (docs/시연방법.md "알려진 한계")
REDA_CUSTOMER_DOMAINS=gmail.com=시연고객사

# 분류: Jev
REDA_CLASSIFIER=jev
TYPESAFE_API_KEY=<키>

# 초안: 서버 Hermes 프로필 reda (컨테이너 설정이 프로필 이름을 덮어쓴다). 한 번에 2통까지만 써서 사용량을 막는다
REDA_AUTO_DRAFT=true
REDA_DRAFT_MAX_PER_RUN=2

# 알림: 급한 메일·일정 메일을 바로 보낸다. 출근 전 요약은 시연에서 끈다
REDA_URGENT_ALERT=true
REDA_SUMMARY_AT=
REDA_SUMMARY_TO=telegram

# 일정 버튼 봇: 시연용 새 봇 토큰 (운영 봇과 같으면 mac-handoff.sh가 멈춘다). 시연 Hermes .env의 TELEGRAM_BOT_TOKEN과는 같은 봇이어도 된다
REDA_SCHEDULE_BOT_TOKEN=<시연 봇 토큰>
# 버튼을 누를 사람 한 명의 텔레그램 숫자 ID (리뷰어). 그룹 채팅은 안 된다: 이 ID가 보낸 버튼만 받는다.
# 리뷰어가 먼저 봇에게 /start를 보내야 봇이 메시지를 보낼 수 있다
REDA_SCHEDULE_CHAT_ID=<리뷰어 텔레그램 숫자 ID>
REDA_CALENDAR_ID=primary
